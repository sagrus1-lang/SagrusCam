<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <LinearLayout android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="#0F172A" android:padding="4dp">
            <Button android:id="@+id/btnShot" style="@style/Btn" android:text="📷&#10;Снимок"/>
            <Button android:id="@+id/btnRec" style="@style/Btn" android:text="⏺&#10;Запись"/>
            <Button android:id="@+id/btnZin" style="@style/Btn" android:text="＋&#10;Zoom"/>
            <Button android:id="@+id/btnZout" style="@style/Btn" android:text="－&#10;Zoom"/>
            <Button android:id="@+id/btnFull" style="@style/Btn" android:text="⛶&#10;Экран"/>
            <Button android:id="@+id/btnExit" style="@style/Btn" android:text="✖&#10;Выход"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/fab" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|end"
        android:layout_margin="12dp" android:background="@drawable/fab_bg" android:gravity="center" android:text="⤡"
        android:textColor="#FFFFFF" android:textSize="22sp" android:alpha="0.6" android:visibility="gone"/>
</FrameLayout>
